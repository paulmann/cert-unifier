# Editor defaults for this repository. Encoding and line endings follow
# .gitattributes: UTF-8 without BOM, LF for text.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4
# `set -euo pipefail` and continuation lines rely on the exact layout.
trim_trailing_whitespace = false

[*.md]
# Markdown hard breaks and some tables depend on trailing whitespace.
trim_trailing_whitespace = false

[*.{bat,cmd,reg}]
end_of_line = crlf

[Makefile]
indent_style = tab
